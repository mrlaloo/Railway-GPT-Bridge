+    def register_open_order(self, order: ShadowOrder) -> None:
+        if order.symbol != self.symbol:
+            raise ValueError("order symbol does not match lane")
+        rung = self.rungs.get(order.level)
+        if rung is None or rung.cycle != order.cycle:
+            raise ValueError("order does not match persisted rung/cycle")
+        if order.side == "buy":
+            rung.last_buy_order_id = order.order_id
+            rung.working_buy_order_id = order.order_id
+        elif order.side == "sell":
+            rung.last_sell_order_id = order.order_id
+            rung.working_sell_order_id = order.order_id
+        else:
+            raise ValueError("unsupported side")
+
+    def clear_open_order(self, order_id: str) -> bool:
+        for rung in self.rungs.values():
+            if rung.working_buy_order_id == order_id:
+                rung.working_buy_order_id = ""
+                return True
+            if rung.working_sell_order_id == order_id:
+                rung.working_sell_order_id = ""
+                return True
+        return False
+
+    def expected_open_order_ids(self) -> set[str]:
+        expected: set[str] = set()
+        for rung in self.rungs.values():
+            if rung.working_buy_order_id:
+                expected.add(rung.working_buy_order_id)
+            if rung.state == "sell_armed" and rung.filled_qty > ZERO:
+                if not rung.working_sell_order_id:
+                    rung.working_sell_order_id = self._order_id("sell", rung)
+                    rung.last_sell_order_id = rung.working_sell_order_id
+                expected.add(rung.working_sell_order_id)
+        return expected
+
+    def reconcile_broker_open_orders(self, broker_orders: List[BrokerOpenOrder]) -> ReconciliationReport:
+        expected = self.expected_open_order_ids()
+        observed = {
+            o.order_id for o in broker_orders
+            if o.symbol == self.symbol and o.order_id.startswith("ALFSH-")
+        }
+        return ReconciliationReport(
+            matched=tuple(sorted(expected & observed)),
+            missing_at_broker=tuple(sorted(expected - observed)),
+            unexpected_at_broker=tuple(sorted(observed - expected)),
+        )
+
+    def build_release_cancel_plan(self, broker_orders: List[BrokerOpenOrder]) -> ReleasePlan:
+        lane_orders = [o for o in broker_orders if o.symbol == self.symbol and o.order_id.startswith("ALFSH-")]
+        if any(o.side.lower() == "sell" for o in lane_orders):
+            return ReleasePlan((), "working_sell")
+        buys = tuple(sorted(o.order_id for o in lane_orders if o.side.lower() == "buy"))
+        return ReleasePlan(buys, "")
+
+    def mark_released_after_cancels(self, broker_orders: List[BrokerOpenOrder]) -> None:
+        remaining = [o for o in broker_orders if o.symbol == self.symbol and o.order_id.startswith("ALFSH-")]
+        if remaining:
+            raise RuntimeError("cannot release lane while Alfred broker orders remain open")
+        if self.inventory_qty() > ZERO:
+            raise RuntimeError("cannot release lane while inventory remains")
+        self.lane_kept = False
+        for rung in self.rungs.values():
+            rung.working_buy_order_id = ""
+            if rung.state == "armed":
+                rung.state = "parked"
+
     def inventory_qty(self) -> Decimal:
