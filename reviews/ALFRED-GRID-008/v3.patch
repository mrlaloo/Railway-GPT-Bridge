+    def test_cash_tight_falls_back_to_one_slot(self):
+        lane = ShadowLane("TEST/USD", D("1.000000"), ShadowConfig(level_budget_usd=D("12.41")), FEES)
+        two = lane.nearest_live_buys(D("0.994"), available_cash_usd=D("25.00"))
+        one = lane.nearest_live_buys(D("0.994"), available_cash_usd=D("12.50"))
+        none = lane.nearest_live_buys(D("0.994"), available_cash_usd=D("9.99"))
+        self.assertEqual(len(two), 2)
+        self.assertEqual(len(one), 1)
+        self.assertEqual(len(none), 0)
+
+    def test_persisted_open_order_reconciles_with_broker_after_restart(self):
+        lane = ShadowLane("TEST/USD", D("1.000000"), ShadowConfig(level_budget_usd=D("12.00")), FEES)
+        buy = lane.nearest_live_buys(D("0.994"))[0]
+        lane.register_open_order(buy)
+        state = json.loads(json.dumps(lane.to_state()))
+        restored = ShadowLane.from_state(state, lane.cfg, FEES)
+        clean = restored.reconcile_broker_open_orders([BrokerOpenOrder(buy.order_id, "TEST/USD", "buy")])
+        self.assertTrue(clean.clean)
+        self.assertEqual(clean.matched, (buy.order_id,))
+
+        missing = restored.reconcile_broker_open_orders([])
+        self.assertEqual(missing.missing_at_broker, (buy.order_id,))
+
+        extra_id = "ALFSH-TESTUSD-L2-C0-BUY"
+        mixed = restored.reconcile_broker_open_orders([
+            BrokerOpenOrder(buy.order_id, "TEST/USD", "buy"),
+            BrokerOpenOrder(extra_id, "TEST/USD", "buy"),
+        ])
+        self.assertEqual(mixed.unexpected_at_broker, (extra_id,))
